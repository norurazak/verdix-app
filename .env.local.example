# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never expose to the client.
# Used for admin-only operations that must bypass RLS (e.g. CSV bulk import).
SUPABASE_SERVICE_ROLE_KEY=
